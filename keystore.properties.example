# Release signing config for Yomu-Re:dive.
#
# 1. Generate a keystore ONCE (keep it and these passwords safe forever — every
#    future update must be signed with the same key, or it won't install over an
#    existing install):
#
#      keytool -genkeypair -v -keystore yomu-release.jks \
#        -keyalg RSA -keysize 4096 -validity 10000 -alias yomu
#
# 2. Copy this file to `keystore.properties` (same directory, repo root) and fill
#    in the real values. `keystore.properties` and *.jks are gitignored.
#
# 3. Build a signed release APK:  ./gradlew assembleRelease
#    -> app/build/outputs/apk/release/app-release.apk

# Path to the keystore file, relative to the repo root (or an absolute path).
storeFile=yomu-release.jks
# Password for the keystore.
storePassword=CHANGE_ME
# Alias you passed to keytool (-alias).
keyAlias=yomu
# Password for that key (often the same as storePassword).
keyPassword=CHANGE_ME
