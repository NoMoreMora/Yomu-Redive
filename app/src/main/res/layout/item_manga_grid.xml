<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_margin="2dp"
	android:background="@drawable/custom_selectable_item_background"
	android:clipChildren="false"
	android:orientation="vertical"
	android:padding="6dp"
	tools:layout_width="140dp">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<org.koitharu.kotatsu.image.ui.CoverImageView
			android:id="@+id/imageView_cover"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="?colorSurfaceContainer"
			android:orientation="horizontal"
			app:allowRgb565="true"
			app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kotatsu.Cover"
			tools:ignore="ContentDescription"
			tools:src="@tools:sample/backgrounds/scenic[5]" />

		<!-- Favourite mark at the top-left, opposite the reading progress ring. -->
		<LinearLayout
			android:id="@+id/layout_indicators"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="top|start"
			android:layout_margin="@dimen/card_indicator_offset"
			android:orientation="vertical">

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

			<ImageView
				android:id="@+id/imageView_favourite"
				android:layout_width="@dimen/card_indicator_size_glyph"
				android:layout_height="@dimen/card_indicator_size_glyph"
				android:background="@drawable/bg_card_indicator"
				android:backgroundTint="?attr/colorTertiaryContainer"
				android:padding="4dp"
				android:src="@drawable/ic_heart"
				android:visibility="gone"
				app:tint="?attr/colorOnTertiaryContainer"
				tools:ignore="ContentDescription"
				tools:visibility="visible" />

			</LinearLayout>

			<!-- Shown for broken/unsupported manga (e.g. imported without a matching source). -->
			<TextView
				android:id="@+id/textView_broken"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:background="@drawable/bg_badge_broken"
				android:paddingHorizontal="6dp"
				android:paddingVertical="1dp"
				android:text="@string/broken"
				android:textAppearance="?attr/textAppearanceLabelSmall"
				android:textColor="?attr/colorOnError"
				android:textStyle="bold"
				android:visibility="gone"
				tools:visibility="visible" />

		</LinearLayout>

		<org.koitharu.kotatsu.history.ui.util.ReadingProgressView
			android:id="@+id/progressView"
			android:layout_width="@dimen/card_indicator_size"
			android:layout_height="@dimen/card_indicator_size"
			android:layout_gravity="top|end"
			android:layout_margin="@dimen/card_indicator_offset"
			app:progressStyle="?attr/readingProgressStyle" />

		<!-- Backdrop for the overlaid title. Sized for two lines and faded to transparent at the
		     top; the gradient itself is built in MangaGridItemAD so it can pick up the theme accent.
		     Kept directly above the cover so the badges and icons still draw over it. -->
		<View
			android:id="@+id/view_scrim"
			android:layout_width="match_parent"
			android:layout_height="72dp"
			android:layout_gravity="bottom"
			android:visibility="gone"
			tools:background="#CC000000"
			tools:visibility="visible" />


		<!-- Shown only by themes that draw the title over the artwork (Expressive).
		     Layout params stay here rather than in the style: layout_* attributes are read by the
		     parent from the tag itself, and do not reliably survive a ?attr style indirection. -->
		<TextView
			android:id="@+id/textView_title_overlay"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom|start"
			android:layout_marginStart="12dp"
			android:layout_marginEnd="12dp"
			android:layout_marginBottom="8dp"
			style="?attr/mangaCoverTitleStyle"
			tools:text="@tools:sample/lorem"
			tools:visibility="visible" />

		<!-- Downloaded / pinned markers: a compact icon strip in the bottom-end corner, kept clear of the
		     favourite + new-chapter cluster (top-start) and the reading-progress ring (top-end) so nothing
		     stacks on top of anything. Drawn last so it stays above the cover and the title scrim. -->
		<org.koitharu.kotatsu.core.ui.widgets.IconsView
			android:id="@+id/iconsView"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom|end"
			android:layout_margin="@dimen/card_indicator_offset"
			android:background="@drawable/bg_list_icons_round"
			android:orientation="horizontal"
			android:padding="4dp"
			app:iconSize="13dp"
			app:iconSpacing="4dp" />

	</FrameLayout>

	<TextView
		android:id="@+id/textView_title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		style="?attr/mangaGridTitleStyle"
		tools:text="@tools:sample/lorem" />

</LinearLayout>
